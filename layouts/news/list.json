{{- /* Elenco delle news pubblicate, letto dallo script scripts/pubblica_social.py
       per la pubblicazione automatica su Facebook e Instagram. */ -}}
{{- $voci := slice -}}
{{- range .RegularPages -}}
  {{- $video := "" -}}{{- with .Params.social_video -}}{{- $video = absURL (strings.TrimPrefix "/" .) -}}{{- end -}}
  {{- $voci = $voci | append (dict
      "id" .File.ContentBaseName
      "titolo" .Title
      "url" .Permalink
      "data" (.Date.Format "2006-01-02")
      "sommario" (.Description | default (.Summary | plainify | htmlUnescape) | strings.TrimSpace)
      "immagine" (partial "news-immagine.html" .)
      "social" (.Params.social | default true)
      "social_testo" (.Params.social_testo | default "")
      "data_evento" (.Params.data_evento | default "")
      "video" $video
      "video_copertina" (.Params.social_video_copertina | default "")
    ) -}}
{{- end -}}
{{- dict "news" $voci | jsonify (dict "indent" "  ") -}}
