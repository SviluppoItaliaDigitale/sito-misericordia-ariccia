# Le pagine HTML non vanno tenute in cache dal browser: a ogni aggiornamento
# del sito si vede subito la versione nuova. Immagini, CSS e JS restano
# cacheabili normalmente.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # CSS e JS hanno l'impronta del contenuto nel nome (es. sito.a1b2c3.css):
  # a ogni modifica cambia il nome, quindi possono restare in cache un anno.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Font auto-ospitati: non cambiano mai.
  <FilesMatch "\.(woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Immagini: un mese (le foto nuove hanno sempre un nome nuovo).
  <FilesMatch "\.(jpe?g|png|webp|gif|svg|ico|avif)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Documenti PDF e indice di ricerca / feed: un giorno.
  <FilesMatch "\.(pdf|json|xml)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Intestazioni di sicurezza: il browser non deve "indovinare" i tipi di
  # file, il sito non può essere incorniciato da altri siti, e non passiamo
  # l'indirizzo completo delle pagine ai siti esterni che linkiamo.
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Tipi MIME corretti per WebP e font (alcuni server non li conoscono).
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Compressione dei file di testo (HTML, CSS, JS, JSON, XML, SVG, font):
# riduce di circa il 70% i byte trasferiti. Se il modulo manca, si ignora.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# Scadenze di cache anche via mod_expires (per i server senza mod_headers).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 day"
  ExpiresByType application/json "access plus 1 day"
</IfModule>

# ---------------------------------------------------------------------------
# HTTPS: ATTIVO dal 15 luglio 2026.
# Certificato dedicato *.misericordia-ariccia.it (Actalis DV, scadenza
# 28/01/2027, rinnovo automatico Aruba). Il redirect HTTP -> HTTPS e l'HSTS
# sono gestiti DAL PROXY DI ARUBA, a monte di questo .htaccess: NON serve
# (e non va aggiunta) una RewriteRule qui — dietro il proxy la variabile
# HTTPS può non essere valorizzata e si creerebbe un loop di redirect.
# ---------------------------------------------------------------------------

# La vecchia cartella di anteprima non esiste più: chi ha un link vecchio
# arriva alla stessa pagina del sito pubblicato alla radice.
RedirectMatch 301 ^/anteprima/(.*)$ https://www.misericordia-ariccia.it/$1

# ---------------------------------------------------------------------------
# Redirect 301 delle pagine del VECCHIO sito (WordPress e sito 2016).
# I vecchi file possono essere ancora presenti sullo spazio Aruba e indicizzati
# dai motori di ricerca: chi arriva da un vecchio link o da Google trova
# la pagina corrispondente del sito nuovo, senza vicoli ciechi.
# ---------------------------------------------------------------------------

# Pagine WordPress (slug censiti nell'inventario contenuti, docs/)
RedirectMatch 301 ^/su-di-noi/?$ https://www.misericordia-ariccia.it/chi-siamo/
RedirectMatch 301 ^/i-nostri-servizi/?$ https://www.misericordia-ariccia.it/servizi/
RedirectMatch 301 ^/formazione/?$ https://www.misericordia-ariccia.it/servizi/formazione/
RedirectMatch 301 ^/telesoccorso/?$ https://www.misericordia-ariccia.it/progetti/
RedirectMatch 301 ^/servizio-civile-nazionale/?$ https://www.misericordia-ariccia.it/servizio-civile/
RedirectMatch 301 ^/portale-trasparenza/?$ https://www.misericordia-ariccia.it/trasparenza/
RedirectMatch 301 ^/i-nostri-progetti/?$ https://www.misericordia-ariccia.it/progetti/
RedirectMatch 301 ^/informativa-sui-cookie/?$ https://www.misericordia-ariccia.it/privacy/
RedirectMatch 301 ^/login/?$ https://www.misericordia-ariccia.it/

# La pagina "Opere di Misericordia" e il dossier erano duplicati con lo
# stesso titolo (segnalato dall'audit): resta solo il dossier.
RedirectMatch 301 ^/opere-di-misericordia/?$ https://www.misericordia-ariccia.it/dossier/le-opere-di-misericordia/

# Pagine del sito 2016 (file .php): contacts.php verso i contatti nuovi,
# ogni altro .php residuo (incluso WordPress: wp-login.php ecc.) verso la home.
RedirectMatch 301 ^/contacts\.php$ https://www.misericordia-ariccia.it/contatti/
RedirectMatch 301 ^/(.*)\.php$ https://www.misericordia-ariccia.it/
